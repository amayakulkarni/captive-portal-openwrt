# Copy to portal.env (gitignored) and edit. On the router: /etc/captive-portal/portal.env
# Values with spaces must be quoted.  chmod 600 portal.env

# ---- Branding -------------------------------------------------------------
NETWORK_NAME="My Network"

# ---- Secrets (REQUIRED - the app refuses to start without them) ------------
# Generate with:  openssl rand -hex 32
ADMIN_API_KEY=
# Credentials that gate sign-up on the trusted ("family"/throttled) subnet
ADMIN_USER=
ADMIN_PASS=

# ---- App --------------------------------------------------------------------
PORT=3000

# ---- Network layout (template - change to match your router) ---------------
# Interface name = <BRIDGE>.<VLAN>, e.g. br-lan.25. Override a single interface
# with IF_FAMILY / IF_GUEST / IF_IOT / IF_NATIVE_IOT / IF_LAN if yours differ.
BRIDGE=br-lan
WAN_IFACE=wan

LAN_VLAN=1             # trusted LAN: may reach IoT subnets, never captive
FAMILY_VLAN=25         # "throttled"/family subnet: admin user+password sign-up
GUEST_VLAN=100         # guest subnet: daily passcode sign-up
IOT_VLAN=75            # IoT: devices registered manually from /admin
NATIVE_IOT_VLAN=125    # second IoT class, registered manually from /admin

FAMILY_SUBNET=192.168.25.0/24
GUEST_SUBNET=192.168.100.0/24
IOT_SUBNET=192.168.75.0/24
NATIVE_IOT_SUBNET=192.168.125.0/24

# Comma-separated MACs that bypass the portal on every portal subnet AND may
# reach the router's management ports (SSH / LuCI). Keep this list short.
PERMANENT_WHITELIST_MACS=02:00:00:00:00:01,02:00:00:00:00:02
